# Copy to server/.env and fill in ONE option. Leave all empty = offline predictor (still works).

# --- AI word prediction (pick one) ---
# GEMINI_API_KEY=            # free for NC State students (aistudio.google.com) - recommended
# GROQ_API_KEY=              # free tier at console.groq.com (also enables server speech-to-text)
# OPENAI_API_KEY=
# OLLAMA_MODEL=llama3.2      # fully local + open source: install Ollama, run `ollama pull llama3.2`

# Optional overrides
# LLM_PROVIDER=gemini        # force one of: openai | groq | gemini | ollama | off
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM_TIMEOUT=4              # seconds; slower answers fall back to offline predictions

# --- Server speech-to-text (optional; Chrome's built-in recognition works without this) ---
# STT_PROVIDER=auto          # auto | local | groq | openai | off
# STT_MODEL=base.en          # for local faster-whisper (pip install faster-whisper)

# ---- Needs page: push emergency / urgent alerts to a caregiver's phone (free) ----
# Install the "ntfy" app, subscribe to the same long random topic name.
# NTFY_TOPIC=adaptiboard-alerts-change-this-7f3k9
# NTFY_SERVER=https://ntfy.sh
